{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-footed2222",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9cbb7bfc-f492-4ac3-bcf7-80d5edfc5802","database_name": "web-app222" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f93c56d4fe984098bae14f47b798fdda" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
